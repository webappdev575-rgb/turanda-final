# Public application settings
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_APP_ENV=production

# Supabase browser client
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase server-only credentials
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://user:password@host:5432/postgres

# Google OAuth (configure the callback at /auth/callback)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Optional external data providers
WEATHER_API_KEY=
TMEX_API_KEY=
COMMODITY_API_KEY=
NEWS_API_KEY=

# Optional AI thumbnail generation for news articles
AI_IMAGE_API_KEY=
AI_IMAGE_PROVIDER=openai
AI_IMAGE_ENDPOINT=

# Optional email delivery provider. Supabase Auth remains the default auth email service.
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional phone verification provider. Supabase Auth remains the default OTP service.
PHONE_VERIFICATION_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Development-only test accounts. Never enable these in production.
DEV_TEST_ACCOUNTS_ENABLED=false

# Scheduled requests must include this secret in the Authorization header.
CRON_SECRET=replace-with-a-long-random-secret

# Optional payment provider credentials used by the payment Edge Function
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
