# Build-time browser settings. Rebuild after changing any NEXT_PUBLIC_* value.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Next.js server runtime only. Keep in the hosting panel, never public_html.
RECAPTCHA_SECRET_KEY=
DEV_TEST_ACCOUNTS_ENABLED=false

# Supabase Edge Function secrets belong in Supabase, NOT the frontend host:
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY (provided by Supabase)
# TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN / TWILIO_FROM_NUMBER (phone verification)
# RESEND_API_KEY (notification delivery; see SECURITY_AUDIT.md before enabling)
# AI_IMAGE_API_KEY / AI_IMAGE_PROVIDER / AI_IMAGE_ENDPOINT (optional thumbnails)
# AI_TEXT_API_KEY / AI_TEXT_ENDPOINT / AI_TEXT_MODEL (optional news translation)
# Online payments are disabled until provider confirmation/webhooks are implemented.
# Google OAuth credentials and auth SMTP configuration belong in Supabase settings.
